# --- Game data: never commit. Users supply their own disc. ---
# (no trailing slash: in worktrees these can be symlinks to the main checkout)
/iso
/extracted
# Generated from the game binary by splat (regenerable, and derived from copyrighted code)
asm/
assets/
*.bin
*.iso
*.img
*.cue
*.chd
*.exe
*.EXE
*.sstate*
*.mcd

# --- Build outputs ---
build/
# Generated by configure.py / splat (regenerated on every configure)
build.ninja
objdiff.json
.ninja_log
.ninja_deps
include/asm_generated
# decomp-permuter work directories (tools/ext/decomp-permuter/import.py)
nonmatchings/
*.o
*.elf
*.map
*.ld.tmp

# --- Local tooling (scripts/setup.sh rebuilds these) ---
# No trailing slashes: in worktrees these are symlinks to the main checkout
# (scripts/worktree_init.sh), and "dir/" patterns don't match symlinks.
# New installed tools go in one of these, or get a line here.
tools/venv
tools/src
tools/binutils
tools/mkpsxiso
tools/gcc
tools/ext
tools/bin
tools/redux
tools/sdl3
tools/sdl3-desktop
tools/imgui
tools/appimage
tools/local.env

# --- Copyrighted SDK files (Psy-Q etc.): user-supplied only ---
tools/psyq
sdk/
*.LIB
*.OBJ

# --- Misc ---
# A crash report of the port written in the repository (the default --crash-dir is the current directory)
crash-*.txt
__pycache__
*.pyc
.splat_cache
/.splat
*.swp
.DS_Store
/ghidra/
*.rep/
*.gpr

# gamedata/ and tools/prebuilt/ live in the separate data checkout (scripts/gamedata_dir.sh), never here.
/gamedata
/tools/prebuilt

# Agent worktrees (Claude Code isolation: worktree)
/.claude/worktrees
